# Xynapse Edge Surveillance Appliance — Environment Configuration
# ==============================================================================

# Network & Host Binding
# Bind to 127.0.0.1 for local single-terminal edge appliance; 0.0.0.0 for dedicated CCTV LAN subnet
XYNAPSE_HOST=127.0.0.1
XYNAPSE_PORT=8000
XYNAPSE_ENV=production

# Camera Hardware Defaults
CAMERA_ID=CAM-01
CAMERA_SOURCE=0
ALERT_COOLDOWN_SECONDS=10
DETECTION_CONFIDENCE=0.50
ENABLE_ALERT_SOUND=true

# Evidence Storage & Retention
TRANSIT_RETENTION_DAYS=30

# Central Command HQ Store-and-Forward Sync
# Outbound HTTP/HTTPS endpoint for centralized tactical synchronization
HQ_SYNC_URL=

# Edge Security & Access Control
# Set unique cryptographic keys in production edge deployments
INTERNAL_WORKER_SECRET=YOUR_INTERNAL_WORKER_SECRET_HERE
ADMIN_API_KEY=YOUR_ADMIN_API_KEY_HERE

# Diagnostic Mode (strictly disabled in production)
ENABLE_DIAGNOSTIC_MODE=false

# Permitted Web Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175,http://localhost:8000,http://127.0.0.1:8000

